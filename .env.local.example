# Copy this file to .env.local and update values for your local machine.
SPRING_PROFILES_ACTIVE=local

# MariaDB
SPRING_DATASOURCE_URL=jdbc:mariadb://localhost:3306/quan_ly_luong
SPRING_DATASOURCE_USERNAME=root
SPRING_DATASOURCE_PASSWORD=123456

# JWT
SECURITY_JWT_SECRET=change-me-local-secret
SECURITY_JWT_EXPIRATION_MILLIS=7200000
SECURITY_JWT_BLACKLIST_PREFIX=blacklist:token:

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379

# Kafka
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_CONSUMER_GROUP=poc-salary-group
APP_KAFKA_TOPIC_SALARY_GENERATE_REQUESTED=salary.generate.requested
APP_KAFKA_TOPIC_SALARY_GENERATE_REQUESTED_DLQ=salary.generate.requested.dlq
APP_KAFKA_TOPIC_PARTITIONS=3
APP_KAFKA_TOPIC_REPLICAS=1
APP_INTEGRATION_KAFKA_CONNECT_URL=http://localhost:8083
APP_INTEGRATION_SCHEMA_REGISTRY_URL=http://localhost:8081

# Salary job cleanup
APP_SALARY_JOB_CLEANUP_ENABLED=true
APP_SALARY_JOB_RETENTION_DAYS=60
APP_SALARY_JOB_CLEANUP_CRON=0 30 2 * * *
